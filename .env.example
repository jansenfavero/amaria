NEXT_PUBLIC_ADSENSE_ARTICLE_END_SLOT=

# Projeto Supabase exclusivo da AMAR.IA (ainda não provisionado).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Reservadas à futura Conselheira Maria, exclusivamente no servidor.
# Não necessárias para executar a Fase 1. Nunca usar prefixo NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=
