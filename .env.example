# Site público. Sem barra no final.
NEXT_PUBLIC_SITE_URL=https://amaria.me
# Desenvolvimento local: habilita testes de robots/sitemap. Na Vercel,
# deployments de produção são indexáveis e previews continuam noindex.
SITE_INDEXABLE=false

# Google AdSense — identificadores públicos. O client e os slots abaixo
# já estão ativos como fallback no código; o slot final aguarda seu ID.
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-7411565684386334
NEXT_PUBLIC_ADSENSE_ARTICLE_TOP_SLOT=8742526806
NEXT_PUBLIC_ADSENSE_ARTICLE_MIDDLE_SLOT=6718998693
NEXT_PUBLIC_ADSENSE_ARTICLE_END_SLOT=

# Projeto Supabase exclusivo da AMARIA (ainda não provisionado).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Reservadas à futura Conselheira Maria, exclusivamente no servidor.
# Não necessárias para executar a Fase 1. Nunca usar prefixo NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=
